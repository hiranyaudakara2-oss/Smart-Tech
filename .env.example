# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# EXAM_HMAC_SECRET: Recommended 32+ character secret on Netlify for sealing exam answer keys and signing student receipts.
# Falls back to a deterministic project-scoped key if unset so Netlify deployments work immediately out of the box.
EXAM_HMAC_SECRET=""

# ADMIN_SESSION_SECRET: Optional secret for signing 24-hour administrator session tokens.
ADMIN_SESSION_SECRET=""

# ADMIN_DIRECT_PASSWORD: Optional override for the direct Administrator Login password (defaults to configured primary password if unset).
ADMIN_DIRECT_PASSWORD=""

# FIREBASE_SERVICE_ACCOUNT_JSON: Optional Google Cloud Service Account JSON string for server-side Firestore lookups when using password-only admin sessions.
FIREBASE_SERVICE_ACCOUNT_JSON=""
